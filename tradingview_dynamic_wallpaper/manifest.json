{
  "manifest_version": 3,
  "name": "TradingView Wallpaper Manager",
  "version": "2.1.0",
  "description": "Manage and apply custom wallpapers directly behind TradingView chart candles.",
  "permissions": ["storage", "unlimitedStorage", "tabs"],
  "host_permissions": ["https://*.tradingview.com/*"],
  "action": {
    "default_title": "Wallpaper Manager",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": ["canvas-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.tradingview.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["manager.html", "manager.js", "manager.css", "canvas-hook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}